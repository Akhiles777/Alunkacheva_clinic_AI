# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
# Каталоги выкладки: deploy/pm2-deploy.sh собирает в .next-build и хранит
# предыдущую сборку в .next-prev. Это тысячи файлов, которые «git add .» на
# сервере однажды утащил в коммит — ветка разошлась с GitHub, и следующий
# `git pull` встал намертво. В репозитории им делать нечего.
/.next-build/
/.next-prev/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma client генерируется, в репозиторий не коммитим
/generated/

# копии базы: внутри персональные данные пациентов — в репозиторий никогда
*.dump
*.sql.gz
