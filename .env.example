# Секреты только здесь и в окружении рантайма, никогда в репозитории (152-ФЗ, §7).
# Хостинг и БД — российские. .env в .gitignore, .env.example держим актуальным.

# ── база
DATABASE_URL="postgresql://user:password@localhost:5432/clinic_crm?schema=public"
# Нужна только для prisma migrate dev: теневая база для проверки миграций.
SHADOW_DATABASE_URL="postgresql://user:password@localhost:5432/clinic_crm_shadow?schema=public"

# ── арендатор по умолчанию (филиал один, но companyId сквозной)
CLINIC_YCLIENTS_COMPANY_ID="0"
CLINIC_NAME="Клиника интегративной медицины"
CLINIC_TIMEZONE="Europe/Moscow"

# ── YCLIENTS (этап 1, интеграция)
YCLIENTS_PARTNER_TOKEN=""
YCLIENTS_USER_TOKEN=""
YCLIENTS_WEBHOOK_SECRET=""

# ── каналы (этап 2)
INSTAGRAM_APP_SECRET=""
INSTAGRAM_PAGE_TOKEN=""
INSTAGRAM_VERIFY_TOKEN=""
WHATSAPP_PROVIDER="wazzup"
WHATSAPP_API_KEY=""
WHATSAPP_WEBHOOK_SECRET=""

# ── очереди и realtime
REDIS_URL="redis://localhost:6379"

# ── web push
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@example.ru"

# ── агент (этап 3). Автономная отправка включается только вручную.
AGENT_AUTONOMOUS="false"
