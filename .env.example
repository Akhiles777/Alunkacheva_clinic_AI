# Секреты только здесь и в окружении рантайма, никогда в репозитории (152-ФЗ, §7).
# Хостинг и БД — российские. .env в .gitignore, .env.example держим актуальным.

# ── база
DATABASE_URL="postgresql://user:password@localhost:5432/clinic_crm?schema=public"
# Нужна только для prisma migrate dev: теневая база для проверки миграций.
SHADOW_DATABASE_URL="postgresql://user:password@localhost:5432/clinic_crm_shadow?schema=public"

# ── арендатор по умолчанию (филиал один, но companyId сквозной)
CLINIC_YCLIENTS_COMPANY_ID="0"
CLINIC_NAME="Клиника интегративной медицины"
CLINIC_TIMEZONE="Europe/Moscow"
# ── источник кабинета для загрузки (открытый вопрос к клинике)
# true  — кабинеты заведены в YCLIENTS ресурсами, читаем ресурс записи
# false — выводим кабинет из Staff.defaultRoomId (работает без ответа клиента)
ROOMS_FROM_RESOURCES="false"


# ── YCLIENTS (этап 1, интеграция)
# Рубильник интеграции. Пока каркас готов, но не подключён — держим false.
YCLIENTS_ENABLED="false"
# Токены филиала хранятся ЗАШИФРОВАННЫМИ в таблице Credential (Настройки →
# Интеграции), а не в env. Эти переменные — для локального bootstrap/справки.
YCLIENTS_PARTNER_TOKEN=""
YCLIENTS_USER_TOKEN=""
YCLIENTS_WEBHOOK_SECRET=""
# Необязательная тонкая настройка клиента (есть разумные значения по умолчанию).
# YCLIENTS_BASE_URL="https://api.yclients.com/api/v1"
# YCLIENTS_MIN_INTERVAL_MS="250"
# YCLIENTS_MAX_RETRIES="4"
# YCLIENTS_RETRY_BASE_MS="500"

# ── каналы (этап 2)
INSTAGRAM_APP_SECRET=""
INSTAGRAM_PAGE_TOKEN=""
INSTAGRAM_VERIFY_TOKEN=""
WHATSAPP_PROVIDER="wazzup"
WHATSAPP_API_KEY=""
WHATSAPP_WEBHOOK_SECRET=""

# ── очереди и realtime
REDIS_URL="redis://localhost:6379"

# ── агент (этап 3). Автономная отправка включается только вручную.
AGENT_AUTONOMOUS="false"

# ── шифрование секретов интеграций (Credential), §3.8
# 32 байта в base64 или hex. Сгенерировать: openssl rand -base64 32
CREDENTIAL_MASTER_KEY=""

# ── ИИ-ассистент (routerai.ru, OpenAI-совместимый). Ключ живёт только на сервере.
# Без ключа ассистент отвечает локальным движком (fallback), не ломается.
ROUTER_AI=""
# ROUTER_AI_BASE_URL="https://routerai.ru/api/v1"
# Модель аналитика владельца (по умолчанию anthropic/claude-sonnet-4.5).
# ROUTER_AI_MODEL="anthropic/claude-sonnet-4.5"
# Модель бота пациентов — проще и дешевле (по умолчанию anthropic/claude-haiku-4.5).
# ROUTER_AI_BOT_MODEL="anthropic/claude-haiku-4.5"

# ── web push (PWA). Сгенерировать: npx web-push generate-vapid-keys
# Без ключей центр уведомлений работает, push просто не отправляется.
#
# Поля легко перепутать, а ошибка выключает push целиком — ни одно уведомление
# не уходит, включая проверочное. Проверить себя:
#   VAPID_PUBLIC  — 87 символов (65 байт), начинается с B
#   VAPID_PRIVATE — 43 символа (32 байта), это ДРУГАЯ строка, не открытый ключ
#   NEXT_PUBLIC_VAPID_PUBLIC — точная копия VAPID_PUBLIC (им подписывается браузер)
#   VAPID_SUBJECT — почта или адрес сайта, НЕ ключ
# Правильность видна на /api/health в разделе push.
#
# Смена ключей делает выданные подписки недействительными: устройства
# переподпишутся сами при следующем входе.
VAPID_PUBLIC=""
VAPID_PRIVATE=""
NEXT_PUBLIC_VAPID_PUBLIC=""
VAPID_SUBJECT="mailto:admin@mera.clinic"

# ── сессии: секрет подписи куки. В продакшене обязателен, иначе приложение
# не стартует — с известным секретом сессию подделает кто угодно.
# Сгенерировать: openssl rand -base64 32
SESSION_SECRET=""

# ── свободная регистрация. По умолчанию закрыта: сотрудников заводит владелец
# в «Настройки → Сотрудники». Исключение — первый запуск: пока учёток нет,
# регистрация доступна и создаёт владельца.
ALLOW_SELF_REGISTRATION="false"

TG_BOT="8676406237:AAF2nitheNXF7qB8aHCm3fHMhRaZhfn488Y"

# ── Telegram-бот пациентов (канал агента).
# Токен у @BotFather. Секрет — произвольная строка: Telegram присылает её в
# заголовке каждого запроса, по ней вебхук отличает настоящие вызовы от чужих.
# Сгенерировать секрет: openssl rand -hex 16
# После деплоя зарегистрировать вебхук:
#   TELEGRAM_BOT_TOKEN=... TELEGRAM_WEBHOOK_SECRET=... APP_URL=https://... node scripts-telegram-setup.mjs
TELEGRAM_BOT_TOKEN=""
TELEGRAM_WEBHOOK_SECRET=""

# Синхронизация с YCLIENTS по расписанию.
#
# Своего планировщика у приложения нет: адрес /api/cron/sync вызывает системный
# cron. Без секрета адрес закрыт — иначе выгрузку мог бы запускать кто угодно и
# упереть клинику в лимит запросов YCLIENTS.
#
# Строка для crontab (каждые полчаса):
#   */30 * * * * curl -sS -H "Authorization: Bearer СЕКРЕТ" http://127.0.0.1:3001/api/cron/sync >/dev/null
CRON_SECRET=
