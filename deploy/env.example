# Боевой контур на VDS.
#
#   cp deploy/env.example .env
#
# Именно .env, и никак иначе: docker compose подставляет ${...} в
# docker-compose.yml только из файла с этим именем. Настройки в файле с другим
# именем попадут внутрь контейнера, но домен и пароль базы в самом compose
# останутся пустыми — и это выяснится уже при запуске.
#
# Файл содержит секреты и в репозиторий не коммитится.

# ── домен и TLS
DOMAIN="crm.example.ru"
TZ="Europe/Moscow"

# ── база (живёт в том же compose, наружу не публикуется)
POSTGRES_USER="clinic"
POSTGRES_PASSWORD="ЗАМЕНИТЕ_НА_ДЛИННЫЙ_СЛУЧАЙНЫЙ"
POSTGRES_DB="clinic"
# Имя хоста db — это имя сервиса в docker-compose.
DATABASE_URL="postgresql://clinic:ЗАМЕНИТЕ_НА_ДЛИННЫЙ_СЛУЧАЙНЫЙ@db:5432/clinic?schema=public"
# Постоянный процесс: пул нормального размера (на Vercel было 1).
DATABASE_POOL_MAX="10"

# ── сессии и шифрование секретов интеграций
# Оба: openssl rand -base64 32
# CREDENTIAL_MASTER_KEY обязан декодироваться ровно в 32 байта — при другой
# длине приложение откажется шифровать ключи интеграций и упадёт при
# сохранении настроек YCLIENTS.
SESSION_SECRET=""
CREDENTIAL_MASTER_KEY=""

# ── push-уведомления. npx web-push generate-vapid-keys
# VAPID_PUBLIC — 87 символов, VAPID_PRIVATE — 43, это РАЗНЫЕ строки.
# NEXT_PUBLIC_VAPID_PUBLIC должен точно совпадать с VAPID_PUBLIC и
# передаётся аргументом сборки: он встраивается в код на этапе build.
VAPID_PUBLIC=""
VAPID_PRIVATE=""
NEXT_PUBLIC_VAPID_PUBLIC=""
VAPID_SUBJECT="mailto:admin@example.ru"

# ── LLM
ROUTER_AI=""

# ── Telegram
TELEGRAM_BOT_TOKEN=""
TELEGRAM_WEBHOOK_SECRET=""

# ── YCLIENTS. Включать ТОЛЬКО после того, как заведены ключи в разделе
# «Интеграции»: при false ни одного обращения к их API не происходит.
YCLIENTS_ENABLED="false"
YCLIENTS_WEBHOOK_SECRET=""
# На сколько лет назад забирать историю при первой выгрузке.
YCLIENTS_HISTORY_YEARS="2"

# ── резервные копии
BACKUP_KEEP_DAYS="14"

# ── ограничения памяти контейнеров
APP_MEMORY_LIMIT="1g"
DB_MEMORY_LIMIT="1g"
