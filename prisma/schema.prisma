// Clinic CRM — локальная проекция YCLIENTS.
//
// YCLIENTS — источник истины по расписанию и деньгам. Всё, что здесь лежит,
// либо приходит из YCLIENTS (модели с yclients*Id), либо принадлежит нам
// целиком (переписка, эскалации, роллапы).
//
// Соглашения:
//   - companyId во всех бизнес-моделях; филиал один, мультиарендность заложена;
//   - деньги — Decimal(12,2), время — Timestamptz(3), хранение в UTC;
//   - deletedAt — мягкое удаление, физический DELETE запрещён;
//   - составные уникальные ключи начинаются с companyId, чтобы внешние ID
//     разных арендаторов не конфликтовали.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────── enums

enum Channel {
  INSTAGRAM
  WHATSAPP
  TELEGRAM
}

enum ConversationStatus {
  BOT_ACTIVE
  ESCALATED
  HUMAN_TAKEOVER
  CLOSED
}

enum MessageDirection {
  IN
  OUT
}

enum AuthorType {
  PATIENT
  BOT
  STAFF
}

enum MessageStatus {
  DRAFT
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
}

/// Исход обращения. Обращение материализуется из переписки:
/// новый Inquiry, если предыдущее сообщение пациента было ≥ 24 ч назад.
enum InquiryOutcome {
  PENDING
  BOOKED
  LOST
}

enum EscalationReason {
  AGENT_REQUEST
  PATIENT_REQUEST
  KEYWORD
  MEDICAL_QUESTION
  MISUNDERSTOOD
  TIMEOUT
  OTHER
}

enum EscalationUrgency {
  LOW
  NORMAL
  HIGH
}

enum EscalationStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum AppointmentStatus {
  CREATED
  CONFIRMED
  ARRIVED
  NO_SHOW
  CANCELLED
}

/// Тип визита. Пересчитывается воркером, а не пишется вебхуком:
/// отменённый задним числом визит переводит следующий в первичные.
///
/// FIRST          — первый в истории пациента ARRIVED-визит;
/// COURSE_SESSION — повторный визит внутри активного курса
///                  (пациент не «вернулся», а идёт по программе);
/// RETURN         — визит вне курса или после завершённого курса,
///                  то есть настоящий возврат пациента.
enum VisitKind {
  FIRST
  COURSE_SESSION
  RETURN
}

/// Направления клиники интегративной медицины.
enum ServiceKind {
  OSTEOPATHY
  BIOFEEDBACK
  IV_THERAPY
  NEUROMEDITATION
  LAB
  OTHER
}

enum CourseStatus {
  ACTIVE
  COMPLETED
  EXPIRED
  CANCELLED
  REFUNDED
}

enum SourceKind {
  MESSENGER
  PHONE
  WEB
  OFFLINE
  REFERRAL
}

enum StaffRole {
  OWNER
  ADMIN
  MANAGER
  DOCTOR
}

enum WebhookProvider {
  YCLIENTS
  INSTAGRAM
  WHATSAPP
}

enum WebhookStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
  SKIPPED
}

enum SyncEntity {
  CLIENTS
  RECORDS
  VISITS
  STAFF
  SERVICES
  RESOURCES
  TRANSACTIONS
}

enum SyncStatus {
  IDLE
  RUNNING
  OK
  FAILED
}

enum AuditAction {
  LOGIN
  LOGOUT
  PATIENT_VIEW
  PATIENT_EXPORT
  CONVERSATION_VIEW
  MESSAGE_SEND
  APPOINTMENT_CREATE
  APPOINTMENT_CANCEL
  SETTINGS_UPDATE
}

// ─────────────────────────────────────────────────────────── арендатор

model Company {
  id               String  @id @default(cuid())
  yclientsId       Int     @unique
  name             String
  /// IANA-зона. Роллапы считаются по локальному дню клиники, хранение — UTC.
  timezone         String  @default("Europe/Moscow")
  currency         String  @default("RUB")
  /// Границы рабочего дня в минутах от полуночи — дефолт для полосы дня и
  /// для кабинетов без собственного расписания. 09:00–21:00.
  dayStartMinute   Int     @default(540)
  dayEndMinute     Int     @default(1260)
  consentPolicyUrl String?
  isActive         Boolean @default(true)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  patients            Patient[]
  conversations       Conversation[]
  messages            Message[]
  inquiries           Inquiry[]
  escalations         Escalation[]
  appointments        Appointment[]
  appointmentServices AppointmentService[]
  services            Service[]
  courses             Course[]
  staff               Staff[]
  rooms               Room[]
  roomSchedules       RoomSchedule[]
  roomExceptions      RoomScheduleException[]
  staffUsers          StaffUser[]
  pushSubscriptions   PushSubscription[]
  sources             Source[]
  webhookEvents       WebhookEvent[]
  auditLogs           AuditLog[]
  syncCursors         SyncCursor[]
  funnelRollups       DailyFunnelRollup[]
  revenueRollups      DailyRevenueRollup[]
  roomLoadRollups     DailyRoomLoadRollup[]

  @@map("companies")
}

// ─────────────────────────────────────────────────────────── пациенты

model Patient {
  id         String    @id @default(cuid())
  companyId  String
  yclientsId Int?
  /// E.164, нормализуется на входе. Индекс БЕЗ unique: один номер
  /// встречается у семьи — дети записаны на телефон родителя.
  phone      String
  /// Как номер пришёл от источника — для разбора спорных случаев.
  phoneRaw   String?
  name       String?
  birthDate  DateTime? @db.Date

  /// Первое появление в базе с учётом импортированной истории YCLIENTS.
  /// Метрика «новые пациенты» считается по нему.
  firstSeenAt  DateTime  @db.Timestamptz(3)
  firstVisitAt DateTime? @db.Timestamptz(3)
  lastVisitAt  DateTime? @db.Timestamptz(3)
  sourceId     String?

  /// Согласие на обработку ПДн: факт и версия политики (152-ФЗ).
  consentGivenAt       DateTime? @db.Timestamptz(3)
  consentPolicyVersion String?

  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  source        Source?        @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  conversations Conversation[]
  inquiries     Inquiry[]
  appointments  Appointment[]
  courses       Course[]

  @@unique([companyId, yclientsId])
  @@index([companyId, phone])
  @@index([companyId, firstSeenAt])
  @@index([companyId, lastVisitAt])
  @@index([companyId, deletedAt])
  @@map("patients")
}

// ─────────────────────────────────────────────────────────── переписка

model Conversation {
  id             String             @id @default(cuid())
  companyId      String
  patientId      String?
  channel        Channel
  /// ig scoped id / номер в WhatsApp.
  externalUserId String
  status         ConversationStatus @default(BOT_ACTIVE)
  assignedToId   String?
  sourceId       String?

  /// До какого момента агент молчит после перехвата человеком.
  /// Время, а не флаг: пауза в 12 ч должна истекать сама.
  botPausedUntil       DateTime? @db.Timestamptz(3)
  /// 24-часовое окно ответа Instagram вне messaging tags.
  replyWindowExpiresAt DateTime? @db.Timestamptz(3)

  startedAt            DateTime  @db.Timestamptz(3)
  lastMessageAt        DateTime  @db.Timestamptz(3)
  /// Отдельно от lastMessageAt: граница обращения считается по сообщениям
  /// пациента, ответы бота новое обращение не открывают.
  lastPatientMessageAt DateTime? @db.Timestamptz(3)
  closedAt             DateTime? @db.Timestamptz(3)
  unreadCount          Int       @default(0)

  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  patient      Patient?      @relation(fields: [patientId], references: [id], onDelete: SetNull)
  assignedTo   StaffUser?    @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  source       Source?       @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  messages     Message[]
  inquiries    Inquiry[]
  escalations  Escalation[]
  appointments Appointment[]

  @@unique([companyId, channel, externalUserId])
  @@index([companyId, status, lastMessageAt])
  @@index([companyId, assignedToId, status])
  @@index([companyId, patientId])
  @@map("conversations")
}

model Message {
  id             String           @id @default(cuid())
  companyId      String
  conversationId String
  /// Дублируется из диалога: внешний ID уникален внутри канала, а не глобально.
  channel        Channel
  direction      MessageDirection
  authorType     AuthorType
  /// StaffUser.id для authorType = STAFF, иначе null.
  authorId       String?
  body           String
  attachments    Json?
  /// ID у провайдера. NULL у черновиков агента — в Postgres NULL не конфликтует.
  externalId     String?
  status         MessageStatus    @default(SENT)
  /// Черновик suggest-режима: показывается администратору, наружу не уходит.
  isDraft        Boolean          @default(false)
  approvedById   String?
  failureReason  String?

  sentAt      DateTime? @db.Timestamptz(3)
  deliveredAt DateTime? @db.Timestamptz(3)
  readAt      DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  deletedAt   DateTime? @db.Timestamptz(3)

  company      Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  approvedBy   StaffUser?   @relation("MessageApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  inquiries    Inquiry[]    @relation("InquiryFirstMessage")

  /// Идемпотентность вебхуков. Не глобальный unique: ID Meta и провайдера
  /// WhatsApp живут в разных пространствах и могут совпасть.
  @@unique([channel, externalId])
  @@index([conversationId, createdAt])
  @@index([companyId, createdAt])
  @@map("messages")
}

/// Обращение — материализованная единица воронки. Создаётся входящим
/// сообщением пациента, если предыдущее было ≥ 24 ч назад.
model Inquiry {
  id             String         @id @default(cuid())
  companyId      String
  conversationId String
  patientId      String?
  sourceId       String
  channel        Channel
  startedAt      DateTime       @db.Timestamptz(3)
  lastMessageAt  DateTime       @db.Timestamptz(3)
  messageCount   Int            @default(1)
  outcome        InquiryOutcome @default(PENDING)
  firstMessageId String?
  /// Атрибуция: запись, к которой привело обращение.
  appointmentId  String?
  bookedAt       DateTime?      @db.Timestamptz(3)
  closedAt       DateTime?      @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  company      Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  patient      Patient?     @relation(fields: [patientId], references: [id], onDelete: SetNull)
  source       Source       @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  firstMessage Message?     @relation("InquiryFirstMessage", fields: [firstMessageId], references: [id], onDelete: SetNull)
  appointment  Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  escalations  Escalation[]

  /// Повторная материализация того же окна не создаёт дубль.
  @@unique([conversationId, startedAt])
  @@index([companyId, startedAt])
  @@index([companyId, sourceId, startedAt])
  @@index([companyId, outcome])
  @@map("inquiries")
}

model Escalation {
  id             String            @id @default(cuid())
  companyId      String
  conversationId String
  inquiryId      String?
  reason         EscalationReason
  reasonText     String?
  urgency        EscalationUrgency @default(NORMAL)
  status         EscalationStatus  @default(OPEN)

  notifiedAt       DateTime? @db.Timestamptz(3)
  acknowledgedById String?
  acknowledgedAt   DateTime? @db.Timestamptz(3)
  resolvedById     String?
  resolvedAt       DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  company        Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  inquiry        Inquiry?     @relation(fields: [inquiryId], references: [id], onDelete: SetNull)
  acknowledgedBy StaffUser?   @relation("EscalationAcknowledgedBy", fields: [acknowledgedById], references: [id], onDelete: SetNull)
  resolvedBy     StaffUser?   @relation("EscalationResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([companyId, status, createdAt])
  @@index([conversationId, createdAt])
  @@map("escalations")
}

// ─────────────────────────────────────────────────────────── приёмы

model Appointment {
  id               String  @id @default(cuid())
  companyId        String
  yclientsRecordId Int
  yclientsVisitId  Int?
  patientId        String
  staffId          String
  roomId           String?
  courseId         String?
  sourceId         String?
  conversationId   String?

  startAt     DateTime @db.Timestamptz(3)
  /// Материализован: загрузка кабинета считается пересечением интервалов,
  /// а не суммой durationMin — иначе наложения удваивают занятость.
  endAt       DateTime @db.Timestamptz(3)
  durationMin Int

  status        AppointmentStatus @default(CREATED)
  /// Сырой код посещения YCLIENTS — на случай расхождения маппинга.
  attendanceRaw Int?

  /// Производные, пересчитываются воркером. Отменённый задним числом визит
  /// переводит следующий в первичные, поэтому вебхук их не пишет.
  isFirstVisit Boolean    @default(false)
  visitKind    VisitKind?

  /// Признанная выручка визита. Для курсовых визитов — доля курса на сеанс,
  /// а не сумма продажи: иначе один платёж за 10 сеансов даёт пик в один день.
  revenue            Decimal @default(0) @db.Decimal(12, 2)
  /// Фактически оплачено по этому визиту в YCLIENTS (для сверки с revenue).
  paidAmount         Decimal @default(0) @db.Decimal(12, 2)
  isPaid             Boolean @default(false)
  /// Порядковый номер сеанса внутри курса, 1-based.
  courseSessionIndex Int?

  /// Дата создания записи в YCLIENTS. Метрика «записались» считается по ней,
  /// а не по дате визита и не по нашему createdAt.
  createdAtYclients DateTime  @db.Timestamptz(3)
  /// Версия записи в YCLIENTS: вебхук со значением меньше сохранённого
  /// отбрасывается — события приходят не по порядку.
  updatedAtYclients DateTime  @db.Timestamptz(3)
  cancelledAt       DateTime? @db.Timestamptz(3)

  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)

  company      Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  patient      Patient              @relation(fields: [patientId], references: [id], onDelete: Restrict)
  staff        Staff                @relation(fields: [staffId], references: [id], onDelete: Restrict)
  room         Room?                @relation(fields: [roomId], references: [id], onDelete: SetNull)
  course       Course?              @relation(fields: [courseId], references: [id], onDelete: SetNull)
  source       Source?              @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  conversation Conversation?        @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  services     AppointmentService[]
  inquiries    Inquiry[]

  @@unique([companyId, yclientsRecordId])
  @@index([companyId, startAt])
  @@index([companyId, staffId, startAt])
  @@index([companyId, roomId, startAt])
  @@index([companyId, patientId, startAt])
  @@index([companyId, status, createdAtYclients])
  @@index([companyId, courseId])
  @@map("appointments")
}

model AppointmentService {
  id            String  @id @default(cuid())
  companyId     String
  appointmentId String
  serviceId     String
  quantity      Int     @default(1)
  /// Цена и длительность на момент визита: прайс меняется, история — нет.
  priceCharged  Decimal @default(0) @db.Decimal(12, 2)
  discount      Decimal @default(0) @db.Decimal(12, 2)
  durationMin   Int

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  company     Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  service     Service     @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@unique([appointmentId, serviceId])
  @@index([companyId, serviceId])
  @@map("appointment_services")
}

model Service {
  id                String      @id @default(cuid())
  companyId         String
  yclientsServiceId Int
  title             String
  kind              ServiceKind @default(OTHER)
  price             Decimal     @default(0) @db.Decimal(12, 2)
  /// Длительности сильно разные: забор анализов 10–15 мин, капельница 60–90.
  durationMin       Int
  /// Продаётся курсом (IV-терапия, БОС-терапия).
  isCourse          Boolean     @default(false)
  defaultSessions   Int?
  isActive          Boolean     @default(true)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  company             Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  appointmentServices AppointmentService[]
  courses             Course[]

  @@unique([companyId, yclientsServiceId])
  @@index([companyId, kind, isActive])
  @@map("services")
}

/// Курс процедур (IV-терапия, БОС — 8–12 сеансов).
/// Выручка признаётся по визиту, а не по продаже: amount делится на
/// sessionsTotal, доля падает в revenue каждого визита. amount хранится
/// целиком для сверки с кассой YCLIENTS.
model Course {
  id                  String       @id @default(cuid())
  companyId           String
  patientId           String
  serviceId           String
  yclientsAbonementId Int?
  sessionsTotal       Int
  sessionsUsed        Int          @default(0)
  amount              Decimal      @db.Decimal(12, 2)
  /// amount / sessionsTotal, округление до копейки. Материализовано, потому
  /// что при неровном делении остаток закрепляется за последним сеансом.
  pricePerSession     Decimal      @db.Decimal(12, 2)
  status              CourseStatus @default(ACTIVE)
  purchasedAt         DateTime     @db.Timestamptz(3)
  expiresAt           DateTime?    @db.Timestamptz(3)
  completedAt         DateTime?    @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  patient      Patient       @relation(fields: [patientId], references: [id], onDelete: Restrict)
  service      Service       @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  appointments Appointment[]

  @@unique([companyId, yclientsAbonementId])
  @@index([companyId, patientId, status])
  @@index([companyId, purchasedAt])
  @@map("courses")
}

// ─────────────────────────────────────────────────────────── ресурсы

model Staff {
  id              String  @id @default(cuid())
  companyId       String
  yclientsStaffId Int
  name            String
  specialty       String?
  /// Маппинг «специалист → кабинет» на случай, если кабинеты не заведены
  /// в YCLIENTS как ресурсы.
  defaultRoomId   String?
  isActive        Boolean @default(true)
  sortOrder       Int     @default(0)

  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  defaultRoom  Room?         @relation("StaffDefaultRoom", fields: [defaultRoomId], references: [id], onDelete: SetNull)
  appointments Appointment[]
  user         StaffUser?

  @@unique([companyId, yclientsStaffId])
  @@index([companyId, isActive])
  @@map("staff")
}

model Room {
  id                 String  @id @default(cuid())
  companyId          String
  /// В YCLIENTS кабинеты ведутся как ресурсы; может отсутствовать.
  yclientsResourceId Int?
  name               String
  isActive           Boolean @default(true)
  sortOrder          Int     @default(0)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  company         Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  schedules       RoomSchedule[]
  exceptions      RoomScheduleException[]
  appointments    Appointment[]
  defaultForStaff Staff[]                 @relation("StaffDefaultRoom")

  @@unique([companyId, yclientsResourceId])
  @@index([companyId, isActive])
  @@map("rooms")
}

/// Регулярное расписание кабинета — знаменатель метрики загрузки.
/// Отдельной таблицей, а не Json: считается кодом и покрывается тестами.
model RoomSchedule {
  id          String    @id @default(cuid())
  companyId   String
  roomId      String
  /// 1 = понедельник … 7 = воскресенье (ISO-8601).
  weekday     Int
  /// Минуты от полуночи в локальной зоне клиники: 540 = 09:00, 1260 = 21:00.
  startMinute Int
  endMinute   Int
  /// Расписание меняется — версионируем, а не переписываем историю.
  validFrom   DateTime  @db.Date
  validTo     DateTime? @db.Date

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  room    Room    @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([roomId, weekday, validFrom])
  @@index([companyId, roomId, weekday])
  @@map("room_schedules")
}

/// Исключение из расписания: праздник, санитарный день, укороченный день.
model RoomScheduleException {
  id          String   @id @default(cuid())
  companyId   String
  roomId      String
  date        DateTime @db.Date
  isClosed    Boolean  @default(true)
  startMinute Int?
  endMinute   Int?
  note        String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  room    Room    @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([roomId, date])
  @@index([companyId, date])
  @@map("room_schedule_exceptions")
}

// ─────────────────────────────────────────────────────────── сотрудники

model StaffUser {
  id           String    @id @default(cuid())
  companyId    String
  email        String
  passwordHash String
  name         String
  role         StaffRole @default(ADMIN)
  /// Связь с карточкой специалиста из YCLIENTS, если сотрудник ещё и врач.
  staffId      String?   @unique
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime? @db.Timestamptz(3)

  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)

  company                 Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  staff                   Staff?             @relation(fields: [staffId], references: [id], onDelete: SetNull)
  subscriptions           PushSubscription[]
  conversations           Conversation[]
  approvedMessages        Message[]          @relation("MessageApprovedBy")
  acknowledgedEscalations Escalation[]       @relation("EscalationAcknowledgedBy")
  resolvedEscalations     Escalation[]       @relation("EscalationResolvedBy")
  auditLogs               AuditLog[]

  @@unique([companyId, email])
  @@index([companyId, role, isActive])
  @@map("staff_users")
}

model PushSubscription {
  id          String  @id @default(cuid())
  companyId   String
  staffUserId String
  /// Endpoint глобально уникален по спецификации Web Push.
  endpoint    String  @unique
  p256dh      String
  auth        String
  userAgent   String?
  /// Подписки протухают: при 410 Gone запись удаляется, до этого копим отказы.
  failureCount Int       @default(0)
  lastSeenAt   DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  staffUser StaffUser @relation(fields: [staffUserId], references: [id], onDelete: Cascade)

  @@index([companyId, staffUserId])
  @@map("push_subscriptions")
}

// ─────────────────────────────────────────────────────────── служебное

model Source {
  id        String     @id @default(cuid())
  companyId String
  code      String
  title     String
  kind      SourceKind
  isActive  Boolean    @default(true)
  sortOrder Int        @default(0)

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  company       Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  patients      Patient[]
  conversations Conversation[]
  inquiries     Inquiry[]
  appointments  Appointment[]
  funnelRollups DailyFunnelRollup[]

  @@unique([companyId, code])
  @@map("sources")
}

/// Сырое событие вебхука. Роут только проверяет подпись и кладёт сюда,
/// разбор — в воркере: отсюда идемпотентность и возможность переиграть.
model WebhookEvent {
  id              String          @id @default(cuid())
  companyId       String?
  provider        WebhookProvider
  externalEventId String
  eventType       String
  payload         Json
  status          WebhookStatus   @default(PENDING)
  attempts        Int             @default(0)
  error           String?

  receivedAt  DateTime  @default(now()) @db.Timestamptz(3)
  processedAt DateTime? @db.Timestamptz(3)

  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@unique([provider, externalEventId])
  @@index([status, receivedAt])
  @@index([companyId, provider, receivedAt])
  @@map("webhook_events")
}

/// Аудит доступа к персональным данным. Тела сообщений сюда не пишем.
model AuditLog {
  id         String      @id @default(cuid())
  companyId  String
  actorId    String?
  action     AuditAction
  entityType String
  entityId   String?
  ip         String?
  userAgent  String?
  meta       Json?

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  company Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  actor   StaffUser? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([companyId, actorId, createdAt])
  @@index([companyId, entityType, entityId])
  @@map("audit_logs")
}

model SyncCursor {
  id           String     @id @default(cuid())
  companyId    String
  entity       SyncEntity
  lastSyncedAt DateTime?  @db.Timestamptz(3)
  lastCursor   String?
  status       SyncStatus @default(IDLE)
  error        String?

  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, entity])
  @@map("sync_cursors")
}

// ─────────────────────────────────────────────────────────── роллапы
//
// Три отдельные таблицы вместо одной общей: в общей ключ уникальности
// содержал бы NULL в неиспользуемых разрезах, а в Postgres NULL != NULL —
// уникальный индекс дубли не поймает.

model DailyFunnelRollup {
  id        String   @id @default(cuid())
  companyId String
  /// Локальный день клиники.
  date      DateTime @db.Date
  sourceId  String

  inquiries   Int @default(0)
  booked      Int @default(0)
  arrived     Int @default(0)
  newPatients Int @default(0)
  escalations Int @default(0)

  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  source  Source  @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([companyId, date, sourceId])
  @@index([companyId, date])
  @@map("daily_funnel_rollups")
}

model DailyRevenueRollup {
  id        String   @id @default(cuid())
  companyId String
  date      DateTime @db.Date
  staffId   String

  appointments Int @default(0)
  arrived      Int @default(0)
  firstVisits  Int @default(0)
  courseVisits Int @default(0)
  returnVisits Int @default(0)
  /// Признанная выручка: разовые визиты целиком + доля курса на сеанс.
  revenue       Decimal @default(0) @db.Decimal(12, 2)
  courseRevenue Decimal @default(0) @db.Decimal(12, 2)

  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, date, staffId])
  @@index([companyId, date])
  @@map("daily_revenue_rollups")
}

model DailyRoomLoadRollup {
  id        String   @id @default(cuid())
  companyId String
  date      DateTime @db.Date
  roomId    String

  /// Занятые минуты — объединение интервалов, наложения не удваиваются.
  busyMinutes    Int @default(0)
  workingMinutes Int @default(0)
  appointments   Int @default(0)
  /// Самое длинное свободное окно за день — где ещё помещается капельница
  /// на 90 минут.
  longestGapMin  Int @default(0)

  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, date, roomId])
  @@index([companyId, date])
  @@map("daily_room_load_rollups")
}
