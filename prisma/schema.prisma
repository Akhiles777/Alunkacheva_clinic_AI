// Clinic CRM — локальная проекция YCLIENTS.
//
// YCLIENTS — источник истины по расписанию и деньгам. Всё, что здесь лежит,
// либо приходит из YCLIENTS (модели с yclients*Id), либо принадлежит нам
// целиком (переписка, эскалации, роллапы).
//
// Соглашения:
//   - companyId во всех бизнес-моделях; филиал один, мультиарендность заложена;
//   - деньги — Decimal(12,2), время — Timestamptz(3), хранение в UTC;
//   - deletedAt — мягкое удаление, физический DELETE запрещён;
//   - составные уникальные ключи начинаются с companyId, чтобы внешние ID
//     разных арендаторов не конфликтовали.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────── enums

/// Повод уведомления. Нужен, чтобы виджет мог группировать и подсвечивать
/// срочное, а не разбирать текст.
enum NotificationKind {
  /// Сообщение во внутреннем чате сотрудников.
  CHAT_MESSAGE
  /// Сообщение от пациента во внешнем канале.
  PATIENT_MESSAGE
  /// Диалог передан человеку.
  ESCALATION
  /// Новая запись на приём.
  BOOKING
  SYSTEM
}

enum Channel {
  INSTAGRAM
  WHATSAPP
  TELEGRAM
  /// Звонок, занесённый вручную. Обращение наравне с сообщением (§8).
  /// На Conversation/Message не используется — только на Inquiry.
  PHONE
}

enum ConversationStatus {
  BOT_ACTIVE
  ESCALATED
  HUMAN_TAKEOVER
  CLOSED
}

enum MessageDirection {
  IN
  OUT
}

enum AuthorType {
  PATIENT
  BOT
  STAFF
}

enum MessageStatus {
  DRAFT
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
}

/// Исход обращения. Обращение материализуется из переписки:
/// новый Inquiry, если предыдущее сообщение пациента было ≥ 24 ч назад.
enum InquiryOutcome {
  PENDING
  BOOKED
  LOST
}

enum EscalationReason {
  AGENT_REQUEST
  PATIENT_REQUEST
  KEYWORD
  MEDICAL_QUESTION
  MISUNDERSTOOD
  TIMEOUT
  OTHER
}

enum EscalationUrgency {
  LOW
  NORMAL
  HIGH
}

enum EscalationStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum AppointmentStatus {
  CREATED
  CONFIRMED
  ARRIVED
  NO_SHOW
  CANCELLED
}

/// Тип визита. Пересчитывается воркером, а не пишется вебхуком:
/// отменённый задним числом визит переводит следующий в первичные.
///
/// FIRST          — первый в истории пациента ARRIVED-визит;
/// COURSE_SESSION — повторный визит внутри активного курса
///                  (пациент не «вернулся», а идёт по программе);
/// RETURN         — визит вне курса или после завершённого курса,
///                  то есть настоящий возврат пациента.
enum VisitKind {
  FIRST
  COURSE_SESSION
  RETURN
}

/// Направления клиники интегративной медицины.
enum ServiceKind {
  OSTEOPATHY
  BIOFEEDBACK
  IV_THERAPY
  NEUROMEDITATION
  LAB
  OTHER
}

enum CourseStatus {
  ACTIVE
  COMPLETED
  EXPIRED
  CANCELLED
  REFUNDED
}

enum SourceKind {
  MESSENGER
  PHONE
  WEB
  OFFLINE
  REFERRAL
}

enum StaffRole {
  OWNER
  ADMIN
  MANAGER
  DOCTOR
}

enum WebhookProvider {
  YCLIENTS
  INSTAGRAM
  WHATSAPP
  TELEGRAM
}

enum WebhookStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
  SKIPPED
}

enum SyncEntity {
  CLIENTS
  RECORDS
  VISITS
  STAFF
  SERVICES
  RESOURCES
  TRANSACTIONS
}

/// Откуда взялась сумма визита.
///
/// «Выручка 3000 ₽» и «выручка 3000 ₽, подставленная из прайса» — разные
/// утверждения, а на экране выглядят одинаково. Пациентке сделали скидку 100%,
/// в записи YCLIENTS честный ноль, а мы поставили ей цену из прайса и записали
/// клинике выручку, которой не было. Провенанс делает такую подстановку
/// видимой и проверяемой.
enum RevenueSource {
  /// Стоимость пришла из самой записи YCLIENTS.
  RECORD
  /// В записи стоимости не было — взяли цену услуги из справочника клиники.
  /// Больше не назначается: остаётся для истории до следующей выгрузки.
  PRICE_LIST
  /// Оплачен раньше: сеанс курса или абонемента. Деньги учтены в день продажи,
  /// сеанс их отрабатывает и своей выручки не даёт.
  PREPAID
  /// Услуга оказана бесплатно: скидка 100%, акция, отработка.
  FREE
  /// Ни стоимости, ни цены в справочнике — сумма неизвестна.
  UNKNOWN
}

/// Состояние обратной записи визита в YCLIENTS (§2).
enum ApptSyncState {
  /// Интеграция выключена — визит живёт только у нас, это нормально.
  LOCAL_ONLY
  /// Ждёт отправки в YCLIENTS.
  PENDING
  /// Записан в YCLIENTS, идентификатор проставлен.
  SYNCED
  /// YCLIENTS отказал: слот занят. Требует решения человека.
  CONFLICT
  /// Другая ошибка отправки — повторяем.
  FAILED
}

enum SyncStatus {
  IDLE
  RUNNING
  OK
  FAILED
}

enum AuditAction {
  LOGIN
  LOGOUT
  PATIENT_VIEW
  PATIENT_EXPORT
  CONVERSATION_VIEW
  MESSAGE_SEND
  APPOINTMENT_CREATE
  APPOINTMENT_CANCEL
  SETTINGS_UPDATE
}

// ─────────────────────────────────────────────────────────── арендатор

model Company {
  id               String  @id @default(cuid())
  yclientsId       Int     @unique
  name             String
  /// IANA-зона. Роллапы считаются по локальному дню клиники, хранение — UTC.
  timezone         String  @default("Europe/Moscow")
  currency         String  @default("RUB")
  /// Границы рабочего дня в минутах от полуночи — дефолт для полосы дня и
  /// для кабинетов без собственного расписания. 09:00–21:00.
  dayStartMinute   Int     @default(540)
  dayEndMinute     Int     @default(1260)
  consentPolicyUrl String?
  isActive         Boolean @default(true)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  patients                 Patient[]
  conversations            Conversation[]
  messages                 Message[]
  inquiries                Inquiry[]
  escalations              Escalation[]
  appointments             Appointment[]
  appointmentServices      AppointmentService[]
  services                 Service[]
  courses                  Course[]
  staff                    Staff[]
  rooms                    Room[]
  roomSchedules            RoomSchedule[]
  roomExceptions           RoomScheduleException[]
  staffUsers               StaffUser[]
  pushSubscriptions        PushSubscription[]
  internalChatRooms        InternalChatRoom[]
  internalChatParticipants InternalChatParticipant[]
  internalChatMessages     InternalChatMessage[]
  aiChats                  AiChat[]
  coursePurchases          CoursePurchase[]
  sources                  Source[]
  webhookEvents            WebhookEvent[]
  auditLogs                AuditLog[]
  syncCursors              SyncCursor[]
  funnelRollups            DailyFunnelRollup[]
  revenueRollups           DailyRevenueRollup[]
  roomLoadRollups          DailyRoomLoadRollup[]
  serviceLoadRollups       DailyServiceLoadRollup[]
  patientPhones            PatientPhone[]
  patientRelations         PatientRelation[]
  patientNotes             PatientNote[]
  callLogs                 CallLog[]
  messageTemplates         MessageTemplate[]
  knowledgeEntries         KnowledgeEntry[]
  settings                 Setting[]
  credentials              Credential[]
  clinicSchedules          ClinicSchedule[]
  clinicExceptions         ClinicScheduleException[]
  serviceRooms             ServiceRoom[]
  consentDocuments         ConsentDocument[]
  patientConsents          PatientConsent[]
  rolePermissions          RolePermission[]
  userPermissions          UserPermission[]
  notifications            Notification[]
  staffRates               StaffRate[]
  payrollPayouts           PayrollPayout[]

  @@map("companies")
}

// ─────────────────────────────────────────────────────────── пациенты

model Patient {
  id         String    @id @default(cuid())
  companyId  String
  yclientsId Int?
  name       String?
  birthDate  DateTime? @db.Date

  /// Первое появление в базе с учётом импортированной истории YCLIENTS.
  /// Метрика «новые пациенты» считается по первому появлению любого номера.
  firstSeenAt    DateTime  @db.Timestamptz(3)
  /// Известна ли дата первого обращения на самом деле.
  ///
  /// У клиента, перенесённого из YCLIENTS без визитов, взять её неоткуда, и в
  /// firstSeenAt попадает день переноса. Такие карточки не новые — они просто
  /// старые, и в «новых пациентах» им не место: иначе вся база разом
  /// становится притоком того месяца, когда запустили выгрузку.
  firstSeenExact Boolean   @default(true)
  firstVisitAt   DateTime? @db.Timestamptz(3)
  lastVisitAt    DateTime? @db.Timestamptz(3)
  sourceId       String?

  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)

  company            Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  source             Source?           @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  conversations      Conversation[]
  inquiries          Inquiry[]
  appointments       Appointment[]     @relation("AppointmentPatient")
  coursePurchases    CoursePurchase[]
  bookedAppointments Appointment[]     @relation("AppointmentBookedByPatient")
  courses            Course[]
  // Телефон вынесен в отдельную таблицу: у пациента несколько номеров,
  // WhatsApp и звонки бывают на разных. Поиск идёт по всем.
  phones             PatientPhone[]
  // Родство: pair (patientId → relatedPatientId). Две стороны отношения.
  relationsOut       PatientRelation[] @relation("RelationOwner")
  relationsIn        PatientRelation[] @relation("RelationTarget")
  notes              PatientNote[]
  callLogs           CallLog[]
  consents           PatientConsent[]

  @@unique([companyId, yclientsId])
  @@index([companyId, firstSeenAt])
  @@index([companyId, lastVisitAt])
  @@index([companyId, deletedAt])
  @@map("patients")
}

// ─────────────────────────────────────────────────────────── переписка

model Conversation {
  id             String             @id @default(cuid())
  companyId      String
  patientId      String?
  channel        Channel
  /// ig scoped id / номер в WhatsApp / chat id в Telegram.
  externalUserId String
  /// Имя, как его отдал канал (Telegram First/Last name, профиль Instagram).
  /// Держим отдельно от Patient.name: до привязки к карточке это единственное,
  /// чем администратор может отличить один диалог от другого. Раньше такие
  /// диалоги показывались как «Без имени».
  contactName    String?
  status         ConversationStatus @default(BOT_ACTIVE)
  assignedToId   String?
  sourceId       String?

  /// До какого момента агент молчит после перехвата человеком.
  /// Время, а не флаг: пауза в 12 ч должна истекать сама.
  botPausedUntil       DateTime? @db.Timestamptz(3)
  /// Когда в последний раз напомнили сотрудникам, что пациент ждёт ответа.
  /// Сбрасывается, как только сотрудник ответил или пациент написал снова.
  remindedAt           DateTime? @db.Timestamptz(3)
  /// Сколько напоминаний уже ушло по текущему ожиданию. Ограничено: цель —
  /// не потерять пациента, а не завалить администратора одним и тем же.
  reminderCount        Int       @default(0)
  /// 24-часовое окно ответа Instagram вне messaging tags.
  replyWindowExpiresAt DateTime? @db.Timestamptz(3)
  /// Телефон собеседника, если его удалось узнать.
  ///
  /// Раньше номер всегда доставали из адреса чата: в WhatsApp это был он же.
  /// WhatsApp перешёл на скрытые идентификаторы («…@lid»), номера в адресе нет,
  /// и держать его теперь негде — кроме как здесь. Заполняется из вебхука,
  /// из справки провайдера или при привязке карточки.
  phoneE164            String?
  /// Когда сотрудник последний раз открывал диалог. По этой отметке считается
  /// «нужен ответ»: диалог, который прочитали, из списка ожидающих уходит.
  staffReadAt          DateTime? @db.Timestamptz(3)
  /// Когда забрали переписку, которая шла в мессенджере до подключения
  /// платформы. Отметка, а не счёт сообщений: диалог мог начаться у нас, а
  /// история за прошлый год всё равно есть у провайдера, и без неё агент
  /// разговаривает с постоянным пациентом как с незнакомым. Тянем один раз.
  historyImportedAt    DateTime? @db.Timestamptz(3)

  startedAt            DateTime  @db.Timestamptz(3)
  lastMessageAt        DateTime  @db.Timestamptz(3)
  /// Отдельно от lastMessageAt: граница обращения считается по сообщениям
  /// пациента, ответы бота новое обращение не открывают.
  lastPatientMessageAt DateTime? @db.Timestamptz(3)
  /// Когда агент запросил согласие на обработку ПДн (§7). Спрашиваем один раз
  /// за диалог: повторять при каждом сообщении нельзя.
  consentAskedAt       DateTime? @db.Timestamptz(3)
  /// Когда пациент согласился. Карточки пациента в этот момент может ещё не
  /// быть, поэтому факт живёт на диалоге и переносится в PatientConsent,
  /// как только карточка появится.
  consentGrantedAt     DateTime? @db.Timestamptz(3)
  closedAt             DateTime? @db.Timestamptz(3)
  unreadCount          Int       @default(0)

  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  patient      Patient?      @relation(fields: [patientId], references: [id], onDelete: SetNull)
  assignedTo   StaffUser?    @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  source       Source?       @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  messages     Message[]
  inquiries    Inquiry[]
  escalations  Escalation[]
  appointments Appointment[]

  @@unique([companyId, channel, externalUserId])
  @@index([companyId, status, lastMessageAt])
  @@index([companyId, assignedToId, status])
  @@index([companyId, patientId])
  @@index([companyId, phoneE164])
  @@map("conversations")
}

model Message {
  id             String           @id @default(cuid())
  companyId      String
  conversationId String
  /// Дублируется из диалога: внешний ID уникален внутри канала, а не глобально.
  channel        Channel
  direction      MessageDirection
  authorType     AuthorType
  /// StaffUser.id для authorType = STAFF, иначе null.
  authorId       String?
  body           String
  attachments    Json?
  /// ID у провайдера. NULL у черновиков агента — в Postgres NULL не конфликтует.
  externalId     String?
  status         MessageStatus    @default(SENT)
  /// Черновик suggest-режима: показывается администратору, наружу не уходит.
  isDraft        Boolean          @default(false)
  approvedById   String?
  failureReason  String?

  sentAt      DateTime? @db.Timestamptz(3)
  deliveredAt DateTime? @db.Timestamptz(3)
  readAt      DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  deletedAt   DateTime? @db.Timestamptz(3)

  company      Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  approvedBy   StaffUser?   @relation("MessageApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  inquiries    Inquiry[]    @relation("InquiryFirstMessage")

  /// Идемпотентность вебхуков. Не глобальный unique: ID Meta и провайдера
  /// WhatsApp живут в разных пространствах и могут совпасть.
  @@unique([channel, externalId])
  @@index([conversationId, createdAt])
  @@index([companyId, createdAt])
  @@map("messages")
}

/// Обращение — материализованная единица воронки. Создаётся входящим
/// сообщением пациента, если предыдущее было ≥ 24 ч назад.
model Inquiry {
  id             String         @id @default(cuid())
  companyId      String
  /// Необязателен: обращение из звонка (channel = PHONE) переписки не имеет.
  conversationId String?
  patientId      String?
  sourceId       String
  channel        Channel
  /// Звонок как обращение (§3.4): ссылка на занесённый CallLog.
  callLogId      String?        @unique
  startedAt      DateTime       @db.Timestamptz(3)
  lastMessageAt  DateTime       @db.Timestamptz(3)
  messageCount   Int            @default(1)
  outcome        InquiryOutcome @default(PENDING)
  firstMessageId String?
  /// Атрибуция: запись, к которой привело обращение.
  appointmentId  String?
  bookedAt       DateTime?      @db.Timestamptz(3)
  closedAt       DateTime?      @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  patient      Patient?      @relation(fields: [patientId], references: [id], onDelete: SetNull)
  source       Source        @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  callLog      CallLog?      @relation(fields: [callLogId], references: [id], onDelete: SetNull)
  firstMessage Message?      @relation("InquiryFirstMessage", fields: [firstMessageId], references: [id], onDelete: SetNull)
  appointment  Appointment?  @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  escalations  Escalation[]

  /// Повторная материализация того же окна не создаёт дубль (для переписки).
  @@unique([conversationId, startedAt])
  @@index([companyId, startedAt])
  @@index([companyId, sourceId, startedAt])
  @@index([companyId, channel, startedAt])
  @@index([companyId, outcome])
  @@map("inquiries")
}

model Escalation {
  id             String            @id @default(cuid())
  companyId      String
  conversationId String
  inquiryId      String?
  reason         EscalationReason
  reasonText     String?
  urgency        EscalationUrgency @default(NORMAL)
  status         EscalationStatus  @default(OPEN)

  notifiedAt       DateTime? @db.Timestamptz(3)
  acknowledgedById String?
  acknowledgedAt   DateTime? @db.Timestamptz(3)
  resolvedById     String?
  resolvedAt       DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  company        Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  inquiry        Inquiry?     @relation(fields: [inquiryId], references: [id], onDelete: SetNull)
  acknowledgedBy StaffUser?   @relation("EscalationAcknowledgedBy", fields: [acknowledgedById], references: [id], onDelete: SetNull)
  resolvedBy     StaffUser?   @relation("EscalationResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([companyId, status, createdAt])
  @@index([conversationId, createdAt])
  @@map("escalations")
}

// ─────────────────────────────────────────────────────────── приёмы

model Appointment {
  id                  String  @id @default(cuid())
  companyId           String
  /// Идентификатор записи в YCLIENTS. NULL — визит создан у нас и туда ещё
  /// не отправлен. Выдумывать значение нельзя: локальные номера сталкивались
  /// бы с настоящими при выгрузке и перезаписывали чужие визиты.
  yclientsRecordId    Int?
  yclientsVisitId     Int?
  patientId           String
  staffId             String
  roomId              String?
  courseId            String?
  sourceId            String?
  conversationId      String?
  /// Основная услуга визита — основной разрез метрик (загрузка по услугам, §8).
  /// Полный перечень услуг визита остаётся в AppointmentService.
  primaryServiceId    String?
  /// Кто оформил визит за другого посетителя (§3.2). Родственник — bookedBy
  /// Patient; сотрудник-оформитель — bookedBy StaffUser. Оба необязательны.
  bookedByPatientId   String?
  bookedByStaffUserId String?
  /// Кто записал, если это не сам посетитель и его нет в базе (родитель
  /// записывает ребёнка, супруг — супругу). Администратору важно видеть, с кем
  /// связываться, а на приём придёт другой человек.
  bookedByName        String?

  startAt     DateTime @db.Timestamptz(3)
  /// Материализован: загрузка кабинета считается пересечением интервалов,
  /// а не суммой durationMin — иначе наложения удваивают занятость.
  endAt       DateTime @db.Timestamptz(3)
  durationMin Int

  status        AppointmentStatus @default(CREATED)
  /// Сырой код посещения YCLIENTS — на случай расхождения маппинга.
  attendanceRaw Int?

  /// Производные, пересчитываются воркером. Отменённый задним числом визит
  /// переводит следующий в первичные, поэтому вебхук их не пишет.
  isFirstVisit Boolean    @default(false)
  visitKind    VisitKind?

  /// Признанная выручка визита. Для курсовых визитов — доля курса на сеанс,
  /// а не сумма продажи: иначе один платёж за 10 сеансов даёт пик в один день.
  revenue            Decimal       @default(0) @db.Decimal(12, 2)
  /// Откуда взялась сумма: из записи, из прайса, бесплатно или неизвестно.
  revenueSource      RevenueSource @default(RECORD)
  /// Фактически оплачено по этому визиту в YCLIENTS (для сверки с revenue).
  paidAmount         Decimal       @default(0) @db.Decimal(12, 2)
  isPaid             Boolean       @default(false)
  /// Порядковый номер сеанса внутри курса, 1-based.
  courseSessionIndex Int?
  /// Свободная заметка администратора при записи: отзыв клиента, проблема,
  /// пожелание. Необязательная; учитывается ИИ-анализом (§6).
  note               String?

  /// Дата создания записи в YCLIENTS. Метрика «записались» считается по ней,
  /// а не по дате визита и не по нашему createdAt.
  createdAtYclients DateTime  @db.Timestamptz(3)
  /// Версия записи в YCLIENTS: вебхук со значением меньше сохранённого
  /// отбрасывается — события приходят не по порядку.
  updatedAtYclients DateTime  @db.Timestamptz(3)
  cancelledAt       DateTime? @db.Timestamptz(3)

  /// Обратная запись в YCLIENTS (§2): состояние, последняя ошибка и число
  /// попыток. Без этого сбой отправки был бы невидим — визит есть у нас, в
  /// YCLIENTS его нет, и слот считается свободным обеими сторонами.
  syncState    ApptSyncState @default(LOCAL_ONLY)
  syncError    String?
  syncAttempts Int           @default(0)
  lastSyncAt   DateTime?     @db.Timestamptz(3)

  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)

  company           Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  patient           Patient              @relation("AppointmentPatient", fields: [patientId], references: [id], onDelete: Restrict)
  staff             Staff                @relation(fields: [staffId], references: [id], onDelete: Restrict)
  room              Room?                @relation(fields: [roomId], references: [id], onDelete: SetNull)
  course            Course?              @relation(fields: [courseId], references: [id], onDelete: SetNull)
  source            Source?              @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  conversation      Conversation?        @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  primaryService    Service?             @relation("AppointmentPrimaryService", fields: [primaryServiceId], references: [id], onDelete: SetNull)
  bookedByPatient   Patient?             @relation("AppointmentBookedByPatient", fields: [bookedByPatientId], references: [id], onDelete: SetNull)
  bookedByStaffUser StaffUser?           @relation("AppointmentBookedByStaff", fields: [bookedByStaffUserId], references: [id], onDelete: SetNull)
  services          AppointmentService[]
  inquiries         Inquiry[]
  callLogs          CallLog[]            @relation("CallResultedInAppointment")

  @@unique([companyId, yclientsRecordId])
  @@index([companyId, startAt])
  @@index([companyId, staffId, startAt])
  @@index([companyId, roomId, startAt])
  @@index([companyId, patientId, startAt])
  @@index([companyId, status, createdAtYclients])
  @@index([companyId, courseId])
  @@index([companyId, primaryServiceId, startAt])
  @@map("appointments")
}

model AppointmentService {
  id            String  @id @default(cuid())
  companyId     String
  appointmentId String
  serviceId     String
  quantity      Int     @default(1)
  /// Цена и длительность на момент визита: прайс меняется, история — нет.
  priceCharged  Decimal @default(0) @db.Decimal(12, 2)
  discount      Decimal @default(0) @db.Decimal(12, 2)
  durationMin   Int

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  company     Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  service     Service     @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@unique([appointmentId, serviceId])
  @@index([companyId, serviceId])
  @@map("appointment_services")
}

model Service {
  id                String      @id @default(cuid())
  companyId         String
  /// Локально созданные услуги ещё не существуют в YCLIENTS — сопоставляются
  /// позже (как Patient.yclientsId). Несколько NULL допустимы.
  yclientsServiceId Int?
  title             String
  kind              ServiceKind @default(OTHER)
  price             Decimal     @default(0) @db.Decimal(12, 2)
  /// Длительности сильно разные: забор анализов 10–15 мин, капельница 60–90.
  durationMin       Int
  /// Продаётся курсом (IV-терапия, БОС-терапия).
  isCourse          Boolean     @default(false)
  defaultSessions   Int?
  /// Порог выпадения из графика в днях — свой для каждой услуги (§4.3).
  stalledAfterDays  Int?
  isActive          Boolean     @default(true)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  company                Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  appointmentServices    AppointmentService[]
  courses                Course[]
  // Кабинеты, где услуга может проводиться — знаменатель загрузки по услугам.
  rooms                  ServiceRoom[]
  primaryForAppointments Appointment[]        @relation("AppointmentPrimaryService")
  knowledgeEntries       KnowledgeEntry[]
  callInterests          CallLog[]            @relation("CallServiceInterest")

  @@unique([companyId, yclientsServiceId])
  @@index([companyId, kind, isActive])
  @@map("services")
}

/// Курс процедур (IV-терапия, БОС — 8–12 сеансов).
/// Выручка признаётся по визиту, а не по продаже: amount делится на
/// sessionsTotal, доля падает в revenue каждого визита. amount хранится
/// целиком для сверки с кассой YCLIENTS.
model Course {
  id                  String       @id @default(cuid())
  companyId           String
  patientId           String
  serviceId           String
  /// Откуда пришли деньги за курс, и от этого зависит выручка (§8).
  /// YCLIENTS — покупка в кассе: этих денег в стоимости визитов нет, и сумма
  /// курса добавляется к выручке дня покупки. MANUAL — курс проведён оплатой в
  /// самой записи приёма: деньги уже посчитаны выручкой того визита, и второй
  /// раз их добавлять нельзя.
  origin              CourseOrigin @default(YCLIENTS)
  yclientsAbonementId Int?
  sessionsTotal       Int
  sessionsUsed        Int          @default(0)
  amount              Decimal      @db.Decimal(12, 2)
  /// amount / sessionsTotal, округление до копейки. Материализовано, потому
  /// что при неровном делении остаток закрепляется за последним сеансом.
  pricePerSession     Decimal      @db.Decimal(12, 2)
  status              CourseStatus @default(ACTIVE)
  purchasedAt         DateTime     @db.Timestamptz(3)
  expiresAt           DateTime?    @db.Timestamptz(3)
  completedAt         DateTime?    @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  patient      Patient       @relation(fields: [patientId], references: [id], onDelete: Restrict)
  service      Service       @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  appointments Appointment[]
  purchases    CoursePurchase[]

  @@unique([companyId, yclientsAbonementId])
  @@index([companyId, patientId, status])
  @@index([companyId, purchasedAt])
  @@map("courses")
}

// ─────────────────────────────────────────────────────────── ресурсы

model Staff {
  id              String  @id @default(cuid())
  companyId       String
  /// Локально заведённый специалист сопоставляется с YCLIENTS позже. NULL допустим.
  yclientsStaffId Int?
  name            String
  specialty       String?
  /// Маппинг «специалист → кабинет» на случай, если кабинеты не заведены
  /// в YCLIENTS как ресурсы.
  defaultRoomId   String?
  isActive        Boolean @default(true)
  sortOrder       Int     @default(0)

  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)

  company      Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  defaultRoom  Room?           @relation("StaffDefaultRoom", fields: [defaultRoomId], references: [id], onDelete: SetNull)
  appointments Appointment[]
  user         StaffUser?
  rate         StaffRate?
  payouts      PayrollPayout[]

  @@unique([companyId, yclientsStaffId])
  @@index([companyId, isActive])
  @@map("staff")
}

model Room {
  id                     String  @id @default(cuid())
  companyId              String
  /// В YCLIENTS кабинеты ведутся как ресурсы; может отсутствовать.
  yclientsResourceId     Int?
  name                   String
  /// Направление кабинета: «IV-терапия», «БОС-терапия», «Остеопатия».
  direction              String?
  /// Наследовать часы работы от клиники (ClinicSchedule) или иметь своё
  /// (RoomSchedule). §3.9, §4.2.
  inheritsClinicSchedule Boolean @default(true)
  isActive               Boolean @default(true)
  sortOrder              Int     @default(0)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  company         Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  schedules       RoomSchedule[]
  exceptions      RoomScheduleException[]
  appointments    Appointment[]
  defaultForStaff Staff[]                 @relation("StaffDefaultRoom")
  services        ServiceRoom[]

  @@unique([companyId, yclientsResourceId])
  @@index([companyId, isActive])
  @@map("rooms")
}

/// Регулярное расписание кабинета — знаменатель метрики загрузки.
/// Отдельной таблицей, а не Json: считается кодом и покрывается тестами.
model RoomSchedule {
  id          String    @id @default(cuid())
  companyId   String
  roomId      String
  /// 1 = понедельник … 7 = воскресенье (ISO-8601).
  weekday     Int
  /// Минуты от полуночи в локальной зоне клиники: 540 = 09:00, 1260 = 21:00.
  startMinute Int
  endMinute   Int
  /// Расписание меняется — версионируем, а не переписываем историю.
  validFrom   DateTime  @db.Date
  validTo     DateTime? @db.Date

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  room    Room    @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([roomId, weekday, validFrom])
  @@index([companyId, roomId, weekday])
  @@map("room_schedules")
}

/// Исключение из расписания: праздник, санитарный день, укороченный день.
model RoomScheduleException {
  id          String   @id @default(cuid())
  companyId   String
  roomId      String
  date        DateTime @db.Date
  isClosed    Boolean  @default(true)
  startMinute Int?
  endMinute   Int?
  note        String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  room    Room    @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([roomId, date])
  @@index([companyId, date])
  @@map("room_schedule_exceptions")
}

// ─────────────────────────────────────────────────────────── сотрудники

/// Продажа курса в кассе YCLIENTS.
///
/// Отдельно от Course, потому что это разные вещи. Продажа — событие с датой и
/// суммой: деньги пришли, и это выручка того дня (§8). Курс — программа
/// сеансов, и он появляется только когда пациент начал ходить.
///
/// Пока продажа хранилась внутри курса, деньги ждали первого сеанса: клиника
/// продала курс двадцатого августа за 26 000 ₽, первый сеанс был позже — и в
/// выручке двадцатого этих денег не было вовсе. То же самое, когда пациент
/// покупает следующий курс, не закончив текущий.
model CoursePurchase {
  id        String @id @default(cuid())
  companyId String
  patientId String
  /// Номер продажи в YCLIENTS: по нему покупка узнаётся при следующей выгрузке.
  yclientsSaleId Int
  amount      Decimal  @db.Decimal(12, 2)
  purchasedAt DateTime @db.Timestamptz(3)
  /// Похожа ли сумма на покупку курса хоть одной курсовой услуги клиники.
  /// Товар и разовая оплата в выручку курсов не идут.
  isCourse    Boolean  @default(true)
  /// Курс, который из неё собрался. Пока сеансов нет — пусто.
  courseId    String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  course  Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)

  @@unique([companyId, yclientsSaleId])
  @@index([companyId, purchasedAt])
  @@map("course_purchases")
}

/// Сохранённый разговор владельца с ИИ-аналитиком.
///
/// Отдельно от Conversation/Message: там пациентские внешние каналы, они
/// участвуют в воронке обращений, 24-часовых окнах и правилах агента (§5).
/// Разбор бизнеса владельцем туда не относится.
///
/// Каждый чат — своя задача: «выручка за квартал», «загрузка кабинетов».
/// Поэтому история хранится, а не живёт до перезагрузки страницы.
model AiChat {
  id        String  @id @default(cuid())
  companyId String
  /// Владелец разговора. Чаты не общие: у каждого свой список.
  userId    String
  /// Заголовок. Первый раз ставится из первого вопроса, дальше правится руками.
  title     String

  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)
  lastMessageAt DateTime  @default(now()) @db.Timestamptz(3)
  /// Мягкое удаление: разбор мог понадобиться в разговоре с клиентом.
  deletedAt     DateTime? @db.Timestamptz(3)

  company  Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user     StaffUser       @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AiChatMessage[]

  @@index([companyId, userId, lastMessageAt])
  @@map("ai_chats")
}

enum AiChatRole {
  USER
  ASSISTANT
}

model AiChatMessage {
  id     String     @id @default(cuid())
  chatId String
  role   AiChatRole
  text   String

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  chat AiChat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId, createdAt])
  @@map("ai_chat_messages")
}

model StaffUser {
  id           String    @id @default(cuid())
  companyId    String
  /// Логин сотрудника. Не почта: клиника заводит людей вручную, требовать
  /// адрес ради входа незачем. Хранится в нижнем регистре.
  login        String
  passwordHash String
  name         String
  role         StaffRole @default(ADMIN)
  /// Связь с карточкой специалиста из YCLIENTS, если сотрудник ещё и врач.
  staffId      String?   @unique
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime? @db.Timestamptz(3)

  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)

  company                  Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  staff                    Staff?                    @relation(fields: [staffId], references: [id], onDelete: SetNull)
  subscriptions            PushSubscription[]
  permissions              UserPermission[]
  notifications            Notification[]
  payrollPayouts           PayrollPayout[]
  conversations            Conversation[]
  approvedMessages         Message[]                 @relation("MessageApprovedBy")
  acknowledgedEscalations  Escalation[]              @relation("EscalationAcknowledgedBy")
  resolvedEscalations      Escalation[]              @relation("EscalationResolvedBy")
  auditLogs                AuditLog[]
  bookedAppointments       Appointment[]             @relation("AppointmentBookedByStaff")
  aiChats                  AiChat[]
  createdNotes             PatientNote[]
  createdCallLogs          CallLog[]
  knowledgeEdits           KnowledgeEntry[]
  settingEdits             Setting[]
  consentDocuments         ConsentDocument[]
  internalChatParticipants InternalChatParticipant[]
  internalChatMessages     InternalChatMessage[]

  @@unique([companyId, login])
  @@index([companyId, role, isActive])
  @@map("staff_users")
}

enum InternalChatKind {
  GENERAL
  DIRECT
}

enum InternalChatMessageKind {
  TEXT
  VOICE
  SYSTEM
}

/// Внутренние чаты сотрудников: общий канал клиники и личные диалоги между
/// реальными StaffUser. Отдельно от Conversation/Message, потому что те — внешние
/// пациентские каналы и участвуют в воронке обращений.
model InternalChatRoom {
  id        String           @id @default(cuid())
  companyId String
  kind      InternalChatKind
  title     String?
  /// Для DIRECT: стабильный ключ двух участников, отсортированные StaffUser.id.
  directKey String?

  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)

  company      Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  participants InternalChatParticipant[]
  messages     InternalChatMessage[]

  @@unique([companyId, kind, directKey])
  @@index([companyId, kind, updatedAt])
  @@map("internal_chat_rooms")
}

model InternalChatParticipant {
  id          String @id @default(cuid())
  companyId   String
  roomId      String
  staffUserId String

  lastReadAt DateTime? @db.Timestamptz(3)
  mutedAt    DateTime? @db.Timestamptz(3)
  deletedAt  DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)

  company   Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  room      InternalChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  staffUser StaffUser        @relation(fields: [staffUserId], references: [id], onDelete: Cascade)

  @@unique([roomId, staffUserId])
  @@index([companyId, staffUserId, deletedAt])
  @@map("internal_chat_participants")
}

model InternalChatMessage {
  id          String                  @id @default(cuid())
  companyId   String
  roomId      String
  authorId    String
  kind        InternalChatMessageKind @default(TEXT)
  body        String                  @default("")
  /// Вложения: patient/course/voice. Голос пока хранит короткий dataUrl в JSON;
  /// при подключении object storage формат останется тем же, только появится url.
  attachments Json?

  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  editedAt    DateTime? @db.Timestamptz(3)
  deletedAt   DateTime? @db.Timestamptz(3)
  deletedById String?

  company Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  room    InternalChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  author  StaffUser        @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([roomId, createdAt])
  @@index([companyId, authorId, createdAt])
  @@map("internal_chat_messages")
}

/// Уведомление сотруднику. Это событие, а не вычисляемый счётчик: только так
/// его можно пометить прочитанным и убрать из колокольчика. Раньше пункты
/// пересчитывались из данных на каждый запрос, и «прочитать» было нечего.
model Notification {
  id          String           @id @default(cuid())
  companyId   String
  /// Получатель. Уведомление всегда адресное: рассылка «всем» разошлась бы
  /// и врачу, которому чужой диалог видеть не положено.
  staffUserId String
  kind        NotificationKind
  title       String
  body        String
  /// Куда ведёт нажатие.
  url         String
  /// Источник события (сообщение, диалог, визит) — чтобы не плодить дубли.
  entityId    String?
  /// Начало текста сообщения. Показывается ТОЛЬКО в приложении, за паролем:
  /// администратор просил видеть суть, не открывая диалог. В push не уходит —
  /// там оно всплыло бы на заблокированном экране (§7).
  preview     String?

  readAt    DateTime? @db.Timestamptz(3)
  /// Когда ушёл push. NULL и пустая ошибка — отправка была отложена (тихие
  /// часы) либо у получателя нет подписки. Без этих полей сбой доставки был
  /// невидим: уведомление в базе есть, а на телефон ничего не пришло, и
  /// понять почему было нельзя.
  pushedAt  DateTime? @db.Timestamptz(3)
  pushError String?
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  staffUser StaffUser @relation(fields: [staffUserId], references: [id], onDelete: Cascade)

  @@index([staffUserId, readAt, createdAt])
  @@index([companyId, createdAt])
  @@map("notifications")
}

/// Ставки оплаты труда сотрудника. Заведены отдельно от Staff: ставка меняется
/// во времени и относится к расчётам, а не к карточке специалиста.
model StaffRate {
  id               String       @id @default(cuid())
  companyId        String
  staffId          String       @unique
  /// Почасовая ставка.
  hourlyRate       Decimal      @default(0) @db.Decimal(12, 2)
  /// Выплата за процедуру, которую сотрудник получает в конце смены.
  perProcedureRate Decimal      @default(0) @db.Decimal(12, 2)
  /// Какие услуги считаются «процедурой» для этой выплаты.
  procedureKind    ServiceKind?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  staff   Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("staff_rates")
}

/// Деньги, выданные сотруднику на руки до конца месяца (в смену за процедуры).
/// Это аванс в счёт начисленного, а не добавка сверху: в конце месяца сумма
/// вычитается из начисленного по часам.
model PayrollPayout {
  id          String   @id @default(cuid())
  companyId   String
  staffId     String
  amount      Decimal  @db.Decimal(12, 2)
  paidAt      DateTime @db.Timestamptz(3)
  reason      String?
  createdById String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  staff     Staff      @relation(fields: [staffId], references: [id], onDelete: Cascade)
  createdBy StaffUser? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([companyId, staffId, paidAt])
  @@map("payroll_payouts")
}

model PushSubscription {
  id           String    @id @default(cuid())
  companyId    String
  staffUserId  String
  /// Endpoint глобально уникален по спецификации Web Push.
  endpoint     String    @unique
  p256dh       String
  auth         String
  userAgent    String?
  /// Подписки протухают: при 410 Gone запись удаляется, до этого копим отказы.
  failureCount Int       @default(0)
  lastSeenAt   DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  staffUser StaffUser @relation(fields: [staffUserId], references: [id], onDelete: Cascade)

  @@index([companyId, staffUserId])
  @@map("push_subscriptions")
}

// ─────────────────────────────────────────────────────────── служебное

model Source {
  id        String     @id @default(cuid())
  companyId String
  code      String
  title     String
  kind      SourceKind
  isActive  Boolean    @default(true)
  sortOrder Int        @default(0)

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  company       Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  patients      Patient[]
  conversations Conversation[]
  inquiries     Inquiry[]
  appointments  Appointment[]
  callLogs      CallLog[]
  funnelRollups DailyFunnelRollup[]

  @@unique([companyId, code])
  @@map("sources")
}

/// Сырое событие вебхука. Роут только проверяет подпись и кладёт сюда,
/// разбор — в воркере: отсюда идемпотентность и возможность переиграть.
model WebhookEvent {
  id              String          @id @default(cuid())
  companyId       String?
  provider        WebhookProvider
  externalEventId String
  eventType       String
  payload         Json
  status          WebhookStatus   @default(PENDING)
  attempts        Int             @default(0)
  error           String?

  receivedAt  DateTime  @default(now()) @db.Timestamptz(3)
  processedAt DateTime? @db.Timestamptz(3)

  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@unique([provider, externalEventId])
  @@index([status, receivedAt])
  @@index([companyId, provider, receivedAt])
  @@map("webhook_events")
}

/// Аудит доступа к персональным данным. Тела сообщений сюда не пишем.
model AuditLog {
  id         String      @id @default(cuid())
  companyId  String
  actorId    String?
  action     AuditAction
  entityType String
  entityId   String?
  ip         String?
  userAgent  String?
  meta       Json?

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  company Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  actor   StaffUser? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([companyId, actorId, createdAt])
  @@index([companyId, entityType, entityId])
  @@map("audit_logs")
}

model SyncCursor {
  id           String     @id @default(cuid())
  companyId    String
  entity       SyncEntity
  lastSyncedAt DateTime?  @db.Timestamptz(3)
  lastCursor   String?
  status       SyncStatus @default(IDLE)
  error        String?

  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, entity])
  @@map("sync_cursors")
}

// ─────────────────────────────────────────────────────────── роллапы
//
// Три отдельные таблицы вместо одной общей: в общей ключ уникальности
// содержал бы NULL в неиспользуемых разрезах, а в Postgres NULL != NULL —
// уникальный индекс дубли не поймает.

model DailyFunnelRollup {
  id        String   @id @default(cuid())
  companyId String
  /// Локальный день клиники.
  date      DateTime @db.Date
  sourceId  String

  inquiries   Int @default(0)
  booked      Int @default(0)
  arrived     Int @default(0)
  newPatients Int @default(0)
  escalations Int @default(0)

  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  source  Source  @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([companyId, date, sourceId])
  @@index([companyId, date])
  @@map("daily_funnel_rollups")
}

model DailyRevenueRollup {
  id        String   @id @default(cuid())
  companyId String
  date      DateTime @db.Date
  staffId   String

  appointments  Int     @default(0)
  arrived       Int     @default(0)
  firstVisits   Int     @default(0)
  courseVisits  Int     @default(0)
  returnVisits  Int     @default(0)
  /// Признанная выручка: разовые визиты целиком + доля курса на сеанс.
  revenue       Decimal @default(0) @db.Decimal(12, 2)
  courseRevenue Decimal @default(0) @db.Decimal(12, 2)

  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, date, staffId])
  @@index([companyId, date])
  @@map("daily_revenue_rollups")
}

model DailyRoomLoadRollup {
  id        String   @id @default(cuid())
  companyId String
  date      DateTime @db.Date
  roomId    String

  /// Занятые минуты — объединение интервалов, наложения не удваиваются.
  busyMinutes    Int @default(0)
  workingMinutes Int @default(0)
  appointments   Int @default(0)
  /// Самое длинное свободное окно за день — где ещё помещается капельница
  /// на 90 минут.
  longestGapMin  Int @default(0)

  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, date, roomId])
  @@index([companyId, date])
  @@map("daily_room_load_rollups")
}

/// Основной разрез загрузки — по услугам (§8): занятые минуты по услуге /
/// доступные минуты кабинетов, где услуга может проводиться (ServiceRoom).
/// serviceId — скаляр без relation, как staffId/roomId в других роллапах.
model DailyServiceLoadRollup {
  id        String   @id @default(cuid())
  companyId String
  date      DateTime @db.Date
  serviceId String

  busyMinutes      Int @default(0)
  availableMinutes Int @default(0)
  appointments     Int @default(0)

  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, date, serviceId])
  @@index([companyId, date])
  @@map("daily_service_load_rollups")
}

// ══════════════════════════════ Волна 1: новые сущности ══════════════════

enum PatientRelationKind {
  PARENT
  GUARDIAN
  SPOUSE
  OTHER
}

enum PatientNoteKind {
  NO_CONSENT
  INCOMPLETE_PASSPORT
  ATTENTION
  CUSTOM
}

enum CallDirection {
  IN
  OUT
}

enum CourseOrigin {
  YCLIENTS
  MANUAL
}

enum MessageTemplateStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

enum CredentialStatus {
  UNKNOWN
  OK
  FAILED
}

/// Права, ограничиваемые ролью. Проверка на сервере в каждом запросе (§9),
/// матрица редактируется в настройках.
enum Permission {
  VIEW_OTHER_PATIENTS
  VIEW_REVENUE
  EDIT_SETTINGS
  MESSAGE_PATIENTS
  VIEW_AUDIT
}

// ─────────────────────────────────────────────────────────── пациент: контакты

/// Телефоны пациента. Один пациент — несколько номеров: WhatsApp и звонки
/// бывают на разных. Поиск идёт по всем. Ровно один isPrimary на пациента —
/// частичным уникальным индексом в миграции.
model PatientPhone {
  id              String  @id @default(cuid())
  companyId       String
  patientId       String
  /// E.164, нормализуется на входе.
  phone           String
  label           String?
  isPrimary       Boolean @default(false)
  usedForWhatsapp Boolean @default(false)

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  /// Номер принадлежит ровно одному пациенту: телефон — единственный надёжный
  /// ключ сопоставления (§4). Без этого ограничения выгрузка из YCLIENTS
  /// заводила вторую карточку с тем же номером, и визиты распределялись между
  /// ними произвольно.
  @@unique([companyId, phone])
  @@index([companyId, phone])
  @@index([patientId])
  @@map("patient_phones")
}

model PatientRelation {
  id               String              @id @default(cuid())
  companyId        String
  patientId        String
  relatedPatientId String
  kind             PatientRelationKind
  createdAt        DateTime            @default(now()) @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  patient Patient @relation("RelationOwner", fields: [patientId], references: [id], onDelete: Cascade)
  related Patient @relation("RelationTarget", fields: [relatedPatientId], references: [id], onDelete: Cascade)

  @@unique([patientId, relatedPatientId, kind])
  @@index([companyId, relatedPatientId])
  @@map("patient_relations")
}

/// Служебная отметка о пациенте. Видна только сотрудникам, никогда не уходит
/// в переписку и в тексты ассистента (§3.3, §6.3).
model PatientNote {
  id          String          @id @default(cuid())
  companyId   String
  patientId   String
  kind        PatientNoteKind
  text        String
  createdById String?
  resolvedAt  DateTime?       @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  patient   Patient    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  createdBy StaffUser? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([companyId, patientId])
  @@index([companyId, resolvedAt])
  @@map("patient_notes")
}

/// Журнал звонков — телефонии нет, заносится вручную одной формой (§3.4).
/// Звонок — обращение наравне с сообщением, связывается с Inquiry (channel=PHONE).
model CallLog {
  id                      String        @id @default(cuid())
  companyId               String
  patientId               String?
  /// E.164.
  phone                   String
  direction               CallDirection
  serviceInterestId       String?
  sourceId                String?
  note                    String?
  createdById             String?
  resultedInAppointmentId String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  company               Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  patient               Patient?     @relation(fields: [patientId], references: [id], onDelete: SetNull)
  serviceInterest       Service?     @relation("CallServiceInterest", fields: [serviceInterestId], references: [id], onDelete: SetNull)
  source                Source?      @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  createdBy             StaffUser?   @relation(fields: [createdById], references: [id], onDelete: SetNull)
  resultedInAppointment Appointment? @relation("CallResultedInAppointment", fields: [resultedInAppointmentId], references: [id], onDelete: SetNull)
  inquiry               Inquiry?

  @@index([companyId, createdAt])
  @@index([companyId, patientId])
  @@map("call_logs")
}

/// Курсы IV: origin=MANUAL (см. Course.origin). БОС — origin=YCLIENTS.

// ─────────────────────────────────────────────────────────── ассистент и связь

/// Шаблоны WhatsApp: вне 24-часового окна пациенту можно писать только
/// заранее утверждённым шаблоном (§3.6). providerTemplateId — идентификатор у
/// провайдера. Отправка различает: окно открыто — свободный текст; закрыто —
/// только APPROVED.
model MessageTemplate {
  id                 String                @id @default(cuid())
  companyId          String
  channel            Channel
  code               String
  title              String
  bodyTemplate       String
  variables          Json?
  providerTemplateId String?
  status             MessageTemplateStatus @default(DRAFT)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, code])
  @@index([companyId, channel, status])
  @@map("message_templates")
}

/// База знаний ассистента. Ассистент отвечает ТОЛЬКО текстами отсюда, не
/// сочиняет (§3.7, §6.3). Часть тем — медицинские, формулирует их клиника.
model KnowledgeEntry {
  id          String  @id @default(cuid())
  companyId   String
  topic       String
  question    String
  answer      String
  serviceId   String?
  isActive    Boolean @default(true)
  updatedById String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  service   Service?   @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  updatedBy StaffUser? @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([companyId, isActive])
  @@index([companyId, serviceId])
  @@map("knowledge_entries")
}

// ─────────────────────────────────────────────────────────── настройки

/// Ключ-значение настроек клиники. Всё, что было в env/сиде/константах.
model Setting {
  companyId   String
  key         String
  value       Json
  updatedById String?
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  updatedBy StaffUser? @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@id([companyId, key])
  @@map("settings")
}

/// Секреты интеграций. Шифруются AES-256-GCM, мастер-ключ из env. В интерфейсе
/// только маска, никогда полностью (§3.8, §9). status — результат проверки связи.
model Credential {
  id             String           @id @default(cuid())
  companyId      String
  provider       String
  keyName        String
  valueEncrypted String
  lastCheckedAt  DateTime?        @db.Timestamptz(3)
  status         CredentialStatus @default(UNKNOWN)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, provider, keyName])
  @@map("credentials")
}

/// Общие часы работы клиники по дням недели. Кабинет наследует их
/// (Room.inheritsClinicSchedule) или имеет своё RoomSchedule.
model ClinicSchedule {
  id          String    @id @default(cuid())
  companyId   String
  /// 1 = понедельник … 7 = воскресенье (ISO-8601).
  weekday     Int
  startMinute Int
  endMinute   Int
  validFrom   DateTime  @db.Date
  validTo     DateTime? @db.Date

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, weekday, validFrom])
  @@index([companyId, weekday])
  @@map("clinic_schedules")
}

/// Исключения из общих часов: праздник, санитарный день, короткий день.
model ClinicScheduleException {
  id          String   @id @default(cuid())
  companyId   String
  date        DateTime @db.Date
  isClosed    Boolean  @default(true)
  startMinute Int?
  endMinute   Int?
  label       String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, date])
  @@index([companyId, date])
  @@map("clinic_schedule_exceptions")
}

/// Где услуга может проводиться. Знаменатель загрузки по услугам: доступные
/// минуты кабинетов, где услуга разрешена (§8, §4.3).
model ServiceRoom {
  id        String @id @default(cuid())
  companyId String
  serviceId String
  roomId    String

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  room    Room    @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([serviceId, roomId])
  @@index([companyId, roomId])
  @@map("service_rooms")
}

// ─────────────────────────────────────────────────────────── согласие, права

/// Версия текста согласия на обработку ПДн. Смена версии → согласие
/// запрашивается заново (§4.10).
model ConsentDocument {
  id          String  @id @default(cuid())
  companyId   String
  version     String
  text        String
  policyUrl   String?
  isActive    Boolean @default(true)
  createdById String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  company   Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy StaffUser?       @relation(fields: [createdById], references: [id], onDelete: SetNull)
  consents  PatientConsent[]

  @@unique([companyId, version])
  @@map("consent_documents")
}

/// Факт согласия пациента на конкретную версию текста.
model PatientConsent {
  id                String   @id @default(cuid())
  companyId         String
  patientId         String
  documentId        String
  grantedAt         DateTime @db.Timestamptz(3)
  channel           Channel?
  /// Ссылка на сообщение-доказательство (скаляр, без relation).
  evidenceMessageId String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  company  Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  patient  Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  document ConsentDocument @relation(fields: [documentId], references: [id], onDelete: Restrict)

  @@unique([patientId, documentId])
  @@index([companyId, patientId])
  @@map("patient_consents")
}

/// Матрица прав по ролям. Редактируется в настройках; проверка прав на
/// сервере читает эти строки (§4.4, §9).
model RolePermission {
  id         String     @id @default(cuid())
  companyId  String
  role       StaffRole
  permission Permission
  allowed    Boolean    @default(false)

  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, role, permission])
  @@map("role_permissions")
}

/// Персональные права сотрудника. Перекрывают матрицу роли: строка есть —
/// решает она, строки нет — действует право роли. Так доступ настраивается
/// по каждому человеку, не ломая роль как разумную заготовку.
model UserPermission {
  id          String     @id @default(cuid())
  companyId   String
  staffUserId String
  permission  Permission
  allowed     Boolean

  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  staffUser StaffUser @relation(fields: [staffUserId], references: [id], onDelete: Cascade)

  @@unique([staffUserId, permission])
  @@index([companyId])
  @@map("user_permissions")
}
